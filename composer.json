{
    "name": "omnisong/odesli",
    "type": "library",
    "description": "Omnisong Odesli: one link to the same song or album on every platform, through song.link's API.",
    "keywords": ["music", "odesli", "songlink", "omnisong"],
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "omnisense/omnisong": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnisong\\Odesli\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnisong\\Odesli\\Tests\\": "Tests/"}
    },
    "config": {"sort-packages": true}
}
